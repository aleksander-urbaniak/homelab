{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": ["update"],
  "kubernetes": {
    "fileMatch": ["^kubernetes/applications/.+\\.ya?ml$"]
  },
  "docker-compose": {
    "fileMatch": [
      "^docker/applications/.+/(?:docker-)?compose\\.ya?ml$",
      "^docker/applications/.+/.+-compose\\.ya?ml$"
    ]
  }
}
