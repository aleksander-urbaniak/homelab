{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["update"],

  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "automergeType": "pr"
    }
  ],

  "kubernetes": {
    "managerFilePatterns": ["/^kubernetes\\/applications\\/.+\\.ya?ml$/"]
  },
  "docker-compose": {
    "managerFilePatterns": [
      "/^docker\\/applications\\/.+\\/(?:docker-)?compose\\.ya?ml$/",
      "/^docker\\/applications\\/.+\\/.+-compose\\.ya?ml$/"
    ]
  }
}
